# Environment
NODE_ENV=development

# Mock Data Mode
USE_MOCK_DATA=true

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_ctrl

# Redis
REDIS_URL=redis://localhost:6379

# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Security (DISABLE FOR LOCAL DEV)
AUTH_ENABLED=false
SESSION_SECRET=local-dev-secret-change-in-production

# Feature Flags (DISABLED FOR LOCAL DEV)
SMC_API_ENABLED=false
ELASTIC_API_ENABLED=false
OPENWEBUI_API_ENABLED=false
CONFLUENCE_API_ENABLED=false
ALERTS_API_ENABLED=false
NOTIFICATIONS_ENABLED=false

# Observability (DISABLED FOR LOCAL DEV)
OTEL_ENABLED=false

# Audit Logging (ENABLED)
AUDIT_LOGGING_ENABLED=true

# Cost Tracking (ENABLED)
COST_TRACKING_ENABLED=true
DAILY_BUDGET_USD=5.00
MONTHLY_BUDGET_USD=50.00

# AI Model Keys (LEAVE BLANK FOR MOCK MODE)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Production API Keys (LEAVE BLANK FOR NOW)
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
SMC_API_TOKEN=
ELASTIC_API_KEY=
OPENWEBUI_API_TOKEN=
CONFLUENCE_API_TOKEN=
ALERTS_API_TOKEN=