# ============================================================================
# AI CTRL Operations Assistant - Staging Environment Variables
# ============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file: cp .env.staging.template .env.staging
# 2. Replace all REPLACE_ME_* values with real credentials
# 3. Never commit .env.staging to git (already in .gitignore)
#
# ============================================================================

# ----------------------------------------------------------------------------
# CORE SETTINGS
# ----------------------------------------------------------------------------
NODE_ENV=staging
USE_MOCK_DATA=false
AUTH_ENABLED=true

# ----------------------------------------------------------------------------
# DATABASE CREDENTIALS
# ----------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://aiops_user:REPLACE_ME_DB_PASSWORD@ai-ctrl-assistant-postgresql:5432/aiops_staging

# Redis connection string
REDIS_URL=redis://:REPLACE_ME_REDIS_PASSWORD@ai-ctrl-assistant-redis-master:6379

# ----------------------------------------------------------------------------
# INTEGRATION API TOKENS (ALL READ-ONLY)
# ----------------------------------------------------------------------------

# SMC Ticketing System
# Where to get: SMC Admin → API Tokens → Create READ-ONLY token
SMC_API_ENABLED=true
SMC_API_URL=https://smc.expedient.com/api
SMC_API_TOKEN=REPLACE_ME_SMC_READONLY_TOKEN

# Elastic (Observability)
# Where to get: Elastic Cloud → API Keys → Create READ-ONLY key
ELASTIC_API_ENABLED=true
ELASTIC_API_URL=https://elastic.expedient.com
ELASTIC_API_KEY=REPLACE_ME_ELASTIC_READONLY_KEY

# OpenWebUI Deployments
# Where to get: OpenWebUI Admin → Settings → API Keys → READ-ONLY
OPENWEBUI_API_ENABLED=true
OPENWEBUI_API_URL=https://openwebui.expedient.com
OPENWEBUI_API_TOKEN=REPLACE_ME_OPENWEBUI_READONLY_TOKEN

# Confluence Documentation
# Where to get: Atlassian Admin → API Tokens → READ-ONLY scope
CONFLUENCE_API_ENABLED=true
CONFLUENCE_API_URL=https://expedient.atlassian.net
CONFLUENCE_API_TOKEN=REPLACE_ME_CONFLUENCE_READONLY_TOKEN

# Alert Systems
# Where to get: Alert Platform → API Access → READ-ONLY token
ALERTS_API_ENABLED=true
ALERTS_API_URL=https://alerts.expedient.com
ALERTS_API_TOKEN=REPLACE_ME_ALERTS_READONLY_TOKEN

# ----------------------------------------------------------------------------
# AUTHENTICATION (Azure AD / Microsoft Entra ID)
# ----------------------------------------------------------------------------
# Where to get: Azure Portal → App Registrations → Your App
AUTH_PROVIDER=azure-ad
AZURE_AD_TENANT_ID=REPLACE_ME_TENANT_ID
AZURE_AD_CLIENT_ID=REPLACE_ME_CLIENT_ID
AZURE_AD_CLIENT_SECRET=REPLACE_ME_CLIENT_SECRET

# Redirect URIs (update these in Azure AD app registration)
AZURE_AD_REDIRECT_URI=https://ai-assistant-staging.expedient.cloud/auth/callback
NEXT_PUBLIC_AUTH_URL=https://ai-assistant-staging.expedient.cloud/auth

# ----------------------------------------------------------------------------
# AI PROVIDER
# ----------------------------------------------------------------------------
# Anthropic Claude API
# Where to get: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=REPLACE_ME_ANTHROPIC_API_KEY

# ----------------------------------------------------------------------------
# OBSERVABILITY
# ----------------------------------------------------------------------------
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# ----------------------------------------------------------------------------
# AUDIT & COMPLIANCE
# ----------------------------------------------------------------------------
AUDIT_LOGGING_ENABLED=true
COST_TRACKING_ENABLED=true

# Cost Limits (USD)
DAILY_BUDGET_USD=10.00
MONTHLY_BUDGET_USD=200.00

# ----------------------------------------------------------------------------
# APPLICATION URLS
# ----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://ai-assistant-staging.expedient.cloud/api
NEXT_PUBLIC_WEB_URL=https://ai-assistant-staging.expedient.cloud
