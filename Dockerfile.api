# syntax=docker/dockerfile:1

# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY turbo.json ./
COPY apps/api/package*.json ./apps/api/
COPY packages/contracts/package*.json ./packages/contracts/
COPY packages/authz/package*.json ./packages/authz/
COPY packages/telemetry/package*.json ./packages/telemetry/

# Install dependencies
RUN npm ci --workspace=@ai-ctrl/api --workspace=@ai-ctrl/contracts --workspace=@ai-ctrl/authz --workspace=@ai-ctrl/telemetry

# Copy source code
COPY apps/api ./apps/api
COPY packages/contracts ./packages/contracts
COPY packages/authz ./packages/authz
COPY packages/telemetry ./packages/telemetry
COPY tsconfig.json ./

# Build
RUN npm run build --workspace=@ai-ctrl/contracts
RUN npm run build --workspace=@ai-ctrl/authz
RUN npm run build --workspace=@ai-ctrl/telemetry
RUN npm run build --workspace=@ai-ctrl/api

# Production stage
FROM node:20-alpine AS runner

# Security: Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 appuser

WORKDIR /app

# Copy built artifacts and dependencies
COPY --from=builder --chown=appuser:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=appuser:nodejs /app/apps/api/dist ./apps/api/dist
COPY --from=builder --chown=appuser:nodejs /app/apps/api/package.json ./apps/api/
COPY --from=builder --chown=appuser:nodejs /app/packages ./packages

# Switch to non-root user
USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:8081/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

EXPOSE 8081

# Use exec form to ensure proper signal handling
CMD ["node", "apps/api/dist/index.js"]