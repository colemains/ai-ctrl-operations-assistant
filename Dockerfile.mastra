FROM node:20-alpine AS base

RUN apk add --no-cache libc6-compat

WORKDIR /app

# Copy everything needed for install
COPY package.json package-lock.json* turbo.json ./
COPY .npmrc* ./

# Copy all workspace files
COPY apps ./apps
COPY packages ./packages
COPY tools ./tools

# Install dependencies - this properly links the workspaces
RUN npm install --legacy-peer-deps

# Build ALL packages (not just mastra)
# This ensures @ai-ctrl/* packages have their dist/ folders
RUN npm run build

# Verify the build output exists
RUN ls -la /app/tools/smc/dist/ || echo "SMC tool not found" && \
    ls -la /app/packages/contracts/dist/ || echo "Contracts dist not found"

# Production stage
FROM node:20-alpine AS runner

WORKDIR /app

# Only copy what's needed to run
COPY --from=base /app/node_modules ./node_modules
COPY --from=base /app/apps/mastra/dist ./apps/mastra/dist
COPY --from=base /app/apps/mastra/package.json ./apps/mastra/

# Copy all other packages and tools for dependency resolution
COPY --from=base /app/packages ./packages
COPY --from=base /app/tools ./tools

ENV NODE_ENV=production
ENV PORT=8080

EXPOSE 8080

CMD ["node", "--no-warnings", "apps/mastra/dist/index.js"]
