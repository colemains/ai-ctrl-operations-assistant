# syntax=docker/dockerfile:1

FROM node:20-alpine

# Install tsx globally for running TypeScript
RUN npm install -g tsx

# Security: Create non-root user
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 appuser

WORKDIR /app

# Copy root package files
COPY package*.json ./
COPY turbo.json ./

# Copy workspace package.json files (only what exists)
COPY apps/mastra/package*.json ./apps/mastra/

# Install ALL dependencies (this will install workspace deps)
RUN npm ci

# Copy all source code
COPY apps/mastra ./apps/mastra
COPY packages ./packages
COPY data/mock ./data/mock

# Change ownership
RUN chown -R appuser:nodejs /app

# Switch to non-root user
USER appuser

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:8080/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

EXPOSE 8080

WORKDIR /app/apps/mastra

# Run with tsx (no build needed)
CMD ["tsx", "src/index.ts"]
